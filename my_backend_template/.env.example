# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=4000
APP_HOST=0.0.0.0
APP_NAME=My Backend Starter
APP_PREFIX=api/v1
# Used to build verification / password reset links
APP_URL=http://localhost:4000

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Comma separated list of trusted reverse proxy addresses.
# Leave empty when running directly without a proxy.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_LOGGING=false

# ---------------------------------------------------------------------------
# JWT
# Generate with: openssl rand -hex 32
# Both secrets must be at least 32 characters.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Rate limiting (in-memory, per process)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Email
# console = logs links to stdout. Swap the provider in AuthModule later.
# ---------------------------------------------------------------------------
EMAIL_SERVICE=console
EMAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# One-time token lifetime
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h

# ---------------------------------------------------------------------------
# Seed script (only used by `npm run seed`, not required to boot the app)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
